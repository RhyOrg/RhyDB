{
  "testCaseName": "UnionAll of two filtered pipelines with group",
  "query": "unionall(default.filter(division='Aargau').project({division}), default.filter(division='Bern').project({division})).group({count:=count()},{division}).order({asc(division)})",
  "expectedQueryResult": [
    {
      "division": "Aargau",
      "count": 6
    },
    {
      "division": "Bern",
      "count": 9
    }
  ]
}
