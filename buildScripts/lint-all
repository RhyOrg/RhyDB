#!/bin/bash

set -euo pipefail

DOCKER_IMAGE="${1:-ghcr.io/rhyorg/rhydb-dependencies:latest}"

echo "Using Docker image: $DOCKER_IMAGE"

# clang-tidy runs on the compilation database written by the CMake configure step, so nothing needs
# to be built. It lints every translation unit of src/, app/ and performance/.
docker run --rm \
  -v "$(pwd)/.clang-tidy:/src/.clang-tidy" \
  -v "$(pwd)/performance:/src/performance" \
  -v "$(pwd)/src:/src/src" \
  -v "$(pwd)/app:/src/app" \
  -v "$(pwd)/CMakeLists.txt:/src/CMakeLists.txt" \
  "$DOCKER_IMAGE" \
  /bin/bash --login -c '
    set -euo pipefail
    cmake -G Ninja -D CMAKE_BUILD_TYPE=Debug -B build/Debug
    run-clang-tidy-23 -p build/Debug -quiet "^/src/(src|app|performance)/"'
