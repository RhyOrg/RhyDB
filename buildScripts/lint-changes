#!/bin/bash

# Exit on any error
set -euo pipefail

# Check if the image argument is provided, otherwise use :latest
DOCKER_IMAGE="${1:-ghcr.io/rhyorg/rhydb-dependencies:latest}"

echo "Using Docker image: $DOCKER_IMAGE"

# Get the list of changed .cpp files from the local Git repository, only (A)dded, (C)reated, and
# (M)odified. Headers are linted through the translation units that include them.
files=$(git diff --name-only --diff-filter=ACM origin/main -- 'src/*.cpp' 'app/*.cpp' 'performance/*.cpp')

# Check if any files were found
if [[ -z "$files" ]]; then
  echo "No changed files found. Exiting."
  exit 0
fi

echo "Changed files:"
echo "$files"

# clang-tidy runs on the compilation database written by the CMake configure step, so nothing needs
# to be built. run-clang-tidy takes regexes, so each file is passed as an anchored path with its
# dots escaped.
docker run --rm \
  -v "$(pwd)/.clang-tidy:/src/.clang-tidy" \
  -v "$(pwd)/performance:/src/performance" \
  -v "$(pwd)/src:/src/src" \
  -v "$(pwd)/app:/src/app" \
  -v "$(pwd)/CMakeLists.txt:/src/CMakeLists.txt" \
  -e files="$files" \
  "$DOCKER_IMAGE" \
  /bin/bash --login -c '
    set -euo pipefail
    cmake -G Ninja -D CMAKE_BUILD_TYPE=Debug -B build/Debug
    patterns=()
    for file in $files; do
      patterns+=("^/src/${file//./\\.}\$")
    done
    run-clang-tidy-23 -p build/Debug -quiet "${patterns[@]}"'
