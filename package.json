{
  "name": "rhydb",
  "private": true,
  "version": "0.0.1",
  "description": "Utility for the RhyDB repository",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.0",
    "release-please": "^17.11.2",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "commitlint:last-commit": "commitlint --from=HEAD~1 --verbose",
    "commitlint:merge-base": "commitlint --from=$(git merge-base HEAD main) --verbose",
    "release-please-dry-run": "npx release-please release-pr --dry-run --config-file=release-please-config.json --manifest-file=.release-please-manifest.json --repo-url='https://github.com/RhyOrg/RhyDB'",
    "release-please-changelog-preview": ".github/scripts/preview-changelog.sh"
  }
}
