{
  "testCaseName": "UnionAll of two filtered pipelines with group",
  "query": "unionAll(default.filter(division='Aargau').project({division}), default.filter(division='Bern').project({division})).group(by:={division},aggs:={count:=count()}).orderBy({asc(division)})",
  "expectedQueryResult": [
    {
      "division": "Aargau",
      "count": 6
    },
    {
      "division": "Bern",
      "count": 9
    }
  ]
}
